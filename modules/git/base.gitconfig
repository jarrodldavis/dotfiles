# Commit Identity
[user]
    name = Jarrod Davis
    email = developer@jarrodldavis.com
[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers
[include]
    path = ~/.gitconfigs/bazzite.gitconfig
    path = ~/.gitconfigs/macos.gitconfig
    path = ~/.gitconfigs/ssh.gitconfig

# Diffs
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[merge]
    conflictstyle = diff3
[diff]
    algorithm = histogram
    colorMoved = default
[delta]
    navigate = true
    light = false
    side-by-side = true

# Other Settings
[core]
    excludesfile = ~/.gitignore
[init]
    defaultBranch = main
[pull]
    rebase = false
[fetch]
    all = true
[push]
    autoSetupRemote = true
    followTags = true
