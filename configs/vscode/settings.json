{
    "chat.agent.maxRequests": 250,
    "chat.agentsControl.enabled": "hidden",
    "chat.editing.confirmEditRequestRemoval": false,
    "chat.editing.confirmEditRequestRetry": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "chatgpt.composerEnterBehavior": "cmdIfMultiline",
    "containers.containerClient": "com.microsoft.visualstudio.containers.podman",
    "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.podmancompose",
    "dataWrangler.defaultViewingFilterOptions": "advanced",
    "dev.containers.copyGitConfig": false,
    "dev.containers.defaultExtensions": [
        "ms-vscode.vscode-commander",
        "ms-vscode.vscode-copilot-data-analysis",
        "openai.chatgpt"
    ],
    "dev.containers.defaultFeatures": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "configureZshAsDefaultShell": true,
            "installOhMyZsh": false,
            "installOhMyZshConfig": false,
            "installZsh": true,
            "upgradePackages": true
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "installDirectlyFromGitHubRelease": true,
            "version": "latest"
        },
        "ghcr.io/hwaien/devcontainer-features/match-host-time-zone:0": {},
        "ghcr.io/jarrodldavis/features/uninstall-oh-my-zsh:1": {}
    },
    "dev.containers.dockerPath": "podman",
    "dev.containers.dockerSocketPath": "/run/user/1000/podman/podman.sock",
    "dev.containers.githubCLILoginWithToken": true,
    "diffEditor.experimental.showMoves": true,
    "diffEditor.hideUnchangedRegions.enabled": true,
    "dotfiles.repository": "jarrodldavis/dotfiles",
    "dotfiles.targetPath": "~/.dotfiles",
    "editor.accessibilitySupport": "off",
    "editor.guides.bracketPairs": true,
    "editor.guides.bracketPairsHorizontal": true,
    "editor.lineNumbers": "relative",
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "all",
    "editor.suggest.showStatusBar": true,
    "explorer.confirmDragAndDrop": false,
    "explorer.fileNesting.enabled": false,
    "extensions.ignoreRecommendations": true,
    "git.blame.editorDecoration.enabled": true,
    "git.confirmSync": false,
    "git.enableCommitSigning": true,
    "git.enableSmartCommit": true,
    "git.fetchOnPull": true,
    "git.openRepositoryInParentFolders": "always",
    "git.showProgress": false,
    "git.terminalAuthentication": false,
    "github.copilot.nextEditSuggestions.enabled": false,
    "go.toolsManagement.autoUpdate": true,
    "gopls": {
        "ui.semanticTokens": true
    },
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://openapi.vercel.sh": true,
        "https://raw.githubusercontent.com/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schema.management.azure.com": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },
    "jupyter.askForKernelRestart": false,
    "jupyter.interactiveWindow.creationMode": "perFile",
    "jupyter.themeMatplotlibPlots": true,
    "jupyter.widgetScriptSources": [
        "jsdelivr.com",
        "unpkg.com"
    ],
    "notebook.diff.overviewRuler": true,
    "notebook.lineNumbers": "on",
    "notebook.output.scrolling": true,
    "pgsql.enableMigrations": false,
    "pgsql.openQueryResultsInTabByDefault": true,
    "pgsql.openQueryResultsInTabByDefaultDoNotShowPrompt": true,
    "platformio-ide.autoOpenPlatformIOIniFile": false,
    "platformio-ide.disablePIOHomeStartup": true,
    "playwright.reuseBrowser": false,
    "playwright.showTrace": false,
    "python-envs.terminal.autoActivationType": "shellStartup",
    "python.terminal.activateEnvironment": false,
    "python.terminal.useEnvFile": true,
    "python.useEnvironmentsExtension": true,
    "redhat.telemetry.enabled": true,
    "remote.autoForwardPortsSource": "hybrid",
    "remote.SSH.defaultExtensions": [
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "mathematic.vscode-pdf",
        "ms-vscode.vscode-commander",
        "ms-vscode.vscode-copilot-data-analysis",
        "openai.chatgpt"
    ],
    "remote.SSH.remotePlatform": {
        "*": "linux"
    },
    "scm.inputFontFamily": "editor",
    "search.quickOpen.includeHistory": false,
    "svelte.enable-ts-plugin": true,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.scrollback": 100000,
    "terminal.integrated.shellIntegration.environmentReporting": true,
    "terminal.integrated.showExitAlert": false,
    "terminal.integrated.stickyScroll.enabled": true,
    "terminal.integrated.suggest.enabled": true,
    "terminal.integrated.suggest.runOnEnter": "exactMatch",
    "tinymist.systemFonts": false,
    "vim.camelCaseMotion.enable": true,
    "vim.easymotion": true,
    "vim.highlightedyank.enable": true,
    "vim.replaceWithRegister": true,
    "vim.sneak": true,
    "window.dialogStyle": "custom",
    "workbench.browser.enableChatTools": true,
    "workbench.sideBar.location": "right"
}
