{
    "chat.agent.maxRequests": 250,
    "chat.agent.sandbox.enabled": "on",
    "chat.agent.sandbox.fileSystem.userConfiguredPaths": {
        "readonlyPaths": [
            "/var/lib/devcontainer-persistent-home/.vscode-server/data/agentSessionData"
        ]
    },
    "chat.agentHost.codexAgent.enabled": true,
    "chat.agentHost.experimental.autoAttachPullRequests": true,
    "chat.agentHost.experimental.markdownPlanRichLinks": true,
    "chat.agentHost.experimental.mcpToolRouting": true,
    "chat.agentHost.experimental.overlapProviderPreparation": true,
    "chat.agentsControl.enabled": "hidden",
    "chat.artifacts.enabled": true,
    "chat.autopilot.advanced.enabled": true,
    "chat.checkpoints.showFileChanges": true,
    "chat.copilot.claudeAdvisor.enabled": true,
    "chat.copilot.ensemble.enabled": true,
    "chat.copilot.ensemble.intelligenceUsesHydraFusion": true,
    "chat.copilot.searchSubagent.enabled": true,
    "chat.copilot.semanticSearch.enabled": true,
    "chat.copilot.stabilityOrderedPrompt.enabled": true,
    "chat.customizations.copilotConnectors.enabled": true,
    "chat.customizations.locationsMigration.enabled": true,
    "chat.customizations.marketplace.enabled": true,
    "chat.customizations.mcpServerMigration.enabled": true,
    "chat.customizations.structuredPreview.enabled": true,
    "chat.customizations.userDataMigration.enabled": true,
    "chat.defaultConfiguration": {
      "approvals": "assisted",
      "mode": "autopilot"
    },
    "chat.defaultToCopilotHarness": true,
    "chat.editing.explainChanges.enabled": true,
    "chat.editor.codex.preferAgentHost": true,
    "chat.editor.preferCopilotHarness": true,
    "chat.experimental.incrementalRendering.animationStyle": "reveal",
    "chat.experimental.incrementalRendering.buffering": "paragraph",
    "chat.experimental.incrementalRendering.enabled": true,
    "chat.experimental.richLinks.enabled": true,
    "chat.experimental.sessionArchiveActionWording": "archive",
    "chat.experimental.sessionStateIndicator.enabled": true,
    "chat.experimental.workspaceSnapshot": true,
    "chat.implicitContext.includeActiveEditor": false,
    "chat.inlineChat.agentHost.enabled": true,
    "chat.mcp.gallery.enabled": true,
    "chat.requestQueuing.defaultAction": "queue",
    "chat.sessionSync.enabled": true,
    "chat.subagents.allowInvocationsFromSubagents": true,
    "chat.subagents.defaultToAuto": true,
    "chat.subagents.showCreditUsage": true,
    "chat.terminal.agentHost.enabled": true,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.tools.compressOutput.enabled": true,
    "chat.tools.terminal.outputCompaction": true,
    "chat.tools.terminal.outputDeltas": true,
    "chat.viewProgressBadge.enabled": true,
    "chat.viewSessions.orientation": "stacked",
    "dataWrangler.defaultViewingFilterOptions": "advanced",
    "dev.containers.copyGitConfig": false,
    "dev.containers.defaultExtensions": [
        "ms-vscode.vscode-commander",
        "ms-vscode.vscode-copilot-data-analysis"
    ],
    "dev.containers.defaultFeatures": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "configureZshAsDefaultShell": true,
            "installOhMyZsh": false,
            "installOhMyZshConfig": false,
            "installZsh": true,
            "upgradePackages": true
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "installDirectlyFromGitHubRelease": true,
            "version": "latest"
        },
        "ghcr.io/jarrodldavis/features/match-host-time-zone:1": {},
        "ghcr.io/jarrodldavis/features/persistent-home:1": {
            "codex": true,
            "githubCopilot": true
        },
        "ghcr.io/jarrodldavis/features/uninstall-oh-my-zsh:1": {}
    },
    "dev.containers.gitCredentialHelperConfigLocation": "none",
    "dev.containers.githubCLILoginWithToken": true,
    "diffEditor.experimental.showMoves": true,
    "diffEditor.hideUnchangedRegions.enabled": true,
    "dotfiles.installCommand": "install.bash",
    "dotfiles.repository": "jarrodldavis/dotfiles",
    "dotfiles.targetPath": "~/.dotfiles",
    "editor.accessibilitySupport": "off",
    "editor.guides.bracketPairs": true,
    "editor.guides.bracketPairsHorizontal": true,
    "editor.lineNumbers": "relative",
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "all",
    "editor.suggest.showStatusBar": true,
    "explorer.confirmDragAndDrop": false,
    "explorer.fileNesting.enabled": false,
    "extensions.ignoreRecommendations": true,
    "git.blame.editorDecoration.enabled": true,
    "git.confirmSync": false,
    "git.enableCommitSigning": true,
    "git.enableSmartCommit": true,
    "git.fetchOnPull": true,
    "git.inputValidation": true,
    "git.openRepositoryInParentFolders": "always",
    "git.showProgress": false,
    "git.terminalAuthentication": false,
    "go.toolsManagement.autoUpdate": true,
    "gopls": {
        "ui.semanticTokens": true
    },
    "inlineChat.affordance": "editor",
    "json.schemaDownload.trustedDomains": {
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://openapi.vercel.sh": true,
        "https://raw.githubusercontent.com/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schema.management.azure.com": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },
    "jupyter.askForKernelRestart": false,
    "jupyter.interactiveWindow.creationMode": "perFile",
    "jupyter.themeMatplotlibPlots": true,
    "jupyter.widgetScriptSources": [
        "jsdelivr.com",
        "unpkg.com"
    ],
    "multiDiffEditor.experimental.fileList": true,
    "notebook.diff.overviewRuler": true,
    "notebook.lineNumbers": "on",
    "notebook.output.scrolling": true,
    "pgsql.enableMigrations": false,
    "pgsql.openQueryResultsInTabByDefault": true,
    "pgsql.openQueryResultsInTabByDefaultDoNotShowPrompt": true,
    "platformio-ide.autoOpenPlatformIOIniFile": false,
    "platformio-ide.disablePIOHomeStartup": true,
    "playwright.reuseBrowser": false,
    "playwright.showTrace": false,
    "python-envs.terminal.autoActivationType": "shellStartup",
    "python.terminal.activateEnvironment": false,
    "python.terminal.useEnvFile": true,
    "python.useEnvironmentsExtension": true,
    "redhat.telemetry.enabled": true,
    "remote.autoForwardPortsSource": "hybrid",
    "remote.SSH.defaultExtensions": [
        "docker.docker",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "ms-vscode.vscode-commander",
        "ms-vscode.vscode-copilot-data-analysis"
    ],
    "remote.SSH.remotePlatform": {
        "*": "linux"
    },
    "remote.SSH.useExecServer": false,
    "scm.inputFontFamily": "editor",
    "search.quickOpen.includeHistory": false,
    "svelte.enable-ts-plugin": true,
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.scrollback": 100000,
    "terminal.integrated.shellIntegration.environmentReporting": true,
    "terminal.integrated.showExitAlert": false,
    "terminal.integrated.stickyScroll.enabled": true,
    "terminal.integrated.suggest.enabled": true,
    "terminal.integrated.suggest.runOnEnter": "exactMatch",
    "tinymist.systemFonts": false,
    "vim.camelCaseMotion.enable": true,
    "vim.easymotion": true,
    "vim.highlightedyank.enable": true,
    "vim.replaceWithRegister": true,
    "vim.sneak": true,
    "window.dialogStyle": "custom",
    "workbench.browser.enableChatTools": true,
    "workbench.browser.enableRemoteProxy": true,
    "workbench.browser.experimentalUserTools.enabled": true,
    "workbench.browser.openLocalhostLinks": true,
    "workbench.browser.searchEngine": "none",
    "workbench.browser.showInTitleBar": true,
    "workbench.sideBar.location": "right"
}
